generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  PLATFORM_ADMIN
  MANAGER
  SALES
  ACCOUNTANT
  INVENTORY
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseType {
  CASH_PURCHASE
  CREDIT_PURCHASE
}

enum InvoiceType {
  CASH_SALE
  CREDIT_SALE
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentPartyType {
  CUSTOMER
  SUPPLIER
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CONVERT
  PAYMENT
  STOCK_OVERRIDE
  SIGNUP
  PASSWORD_RESET
  PASSWORD_CHANGE
  SETTINGS_CHANGE
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  description String?          @db.VarChar(255)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                     String                  @id @default(cuid())
  supabaseAuthId         String?                 @unique @db.Uuid
  name                   String                  @db.VarChar(150)
  email                  String                  @unique @db.VarChar(191)
  status                 UserStatus              @default(ACTIVE)
  image                  String?                 @db.VarChar(500)
  roleId                 Int
  role                   Role                    @relation(fields: [roleId], references: [id])
  businessAccess         Json?
  accountOwnerId         String?
  accountOwner           User?                   @relation("AccountMembers", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  accountMembers         User[]                  @relation("AccountMembers")
  leads                  Lead[]                  @relation("LeadAssignee")
  tenantLeads            Lead[]                  @relation("LeadTenant")
  ownedDeals             Deal[]                  @relation("DealOwner")
  assignedTasks          Task[]                  @relation("TaskAssignee")
  createdTasks           Task[]                  @relation("TaskCreator")
  authoredNotes          Note[]                  @relation("NoteAuthor")
  tenantNotes            Note[]                  @relation("NoteTenant")
  activityLogs           ActivityLog[]
  createdInvoices        Invoice[]               @relation("InvoiceCreator")
  tenantInvoices         Invoice[]               @relation("InvoiceTenant")
  createdPayments        Payment[]               @relation("PaymentCreator")
  tenantPayments         Payment[]               @relation("PaymentTenant")
  createdStockMovements  StockMovement[]         @relation("StockMovementCreator")
  tenantStockMovements   StockMovement[]         @relation("StockMovementTenant")
  notificationPreference NotificationPreference?
  companies              Company[]
  contacts               Contact[]
  deals                  Deal[]
  tasks                  Task[]
  documents              Document[]
  categories             Category[]
  warehouses             Warehouse[]
  products               Product[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  expenses               Expense[]
  companySettings        CompanySetting[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([roleId, status])
  @@index([accountOwnerId, status])
}

model Company {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(191)
  website         String?   @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  email           String?   @db.VarChar(191)
  address         String?   @db.Text
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  leads           Lead[]
  deals           Deal[]
  supplierProfile Supplier?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([userId, name])
}

model Lead {
  id                 String     @id @default(cuid())
  firstName          String     @db.VarChar(100)
  lastName           String?    @db.VarChar(100)
  email              String?    @db.VarChar(191)
  phone              String?    @db.VarChar(50)
  source             String?    @db.VarChar(100)
  status             LeadStatus @default(NEW)
  companyId          String?
  company            Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedToId       String?
  assignedTo         User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  userId             String
  user               User       @relation("LeadTenant", fields: [userId], references: [id], onDelete: Cascade)
  convertedContactId String?    @unique
  convertedContact   Contact?   @relation("ConvertedLead", fields: [convertedContactId], references: [id], onDelete: SetNull)
  notes              Note[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([userId, email])
  @@index([userId, status, assignedToId])
  @@index([userId, companyId])
}

model Contact {
  id             String        @id @default(cuid())
  firstName      String        @db.VarChar(100)
  lastName       String?       @db.VarChar(100)
  email          String?       @db.VarChar(191)
  phone          String?       @db.VarChar(50)
  address        String?       @db.Text
  status         ContactStatus @default(ACTIVE)
  tags           Json?
  currentBalance Decimal       @default(0) @db.Decimal(18, 2)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceLead     Lead?         @relation("ConvertedLead")
  deals          Deal[]
  invoices       Invoice[]
  payments       Payment[]
  notes          Note[]
  documents      Document[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, email])
  @@index([userId, companyId, status])
  @@index([userId, firstName, lastName])
}

model Deal {
  id                String    @id @default(cuid())
  title             String    @db.VarChar(191)
  value             Decimal   @db.Decimal(18, 2)
  stage             DealStage @default(PROSPECTING)
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  position          Int       @default(0)
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks             Task[]
  notes             Note[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, stage, position])
  @@index([userId, ownerId, expectedCloseDate])
  @@index([userId, contactId])
}

model Task {
  id           String       @id @default(cuid())
  title        String       @db.VarChar(191)
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  reminderAt   DateTime?
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId       String?
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, assignedToId, status, dueAt])
  @@index([userId, dealId])
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  userId    String
  user      User     @relation("NoteTenant", fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, leadId, createdAt])
  @@index([userId, contactId, createdAt])
  @@index([userId, dealId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  url       String   @db.VarChar(500)
  mimeType  String?  @db.VarChar(100)
  size      Int?
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, contactId, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(150)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String          @db.VarChar(150)
  address   String?         @db.Text
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id              String              @id @default(cuid())
  name            String              @db.VarChar(191)
  sku             String              @db.VarChar(100)
  unit            String              @db.VarChar(30)
  purchasePrice   Decimal             @db.Decimal(18, 2)
  salePrice       Decimal             @db.Decimal(18, 2)
  taxRate         Decimal             @default(0) @db.Decimal(7, 4)
  currentQuantity Decimal             @default(0) @db.Decimal(18, 3)
  minimumStock    Decimal             @default(0) @db.Decimal(18, 3)
  active          Boolean             @default(true)
  categoryId      String?
  category        Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseItems   PurchaseOrderItem[]
  invoiceItems    InvoiceItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([userId, sku])
  @@index([userId, categoryId, active])
  @@index([userId, name])
  @@index([userId, currentQuantity, minimumStock])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String          @db.VarChar(191)
  contactPerson  String?         @db.VarChar(150)
  email          String?         @db.VarChar(191)
  phone          String?         @db.VarChar(50)
  address        String?         @db.Text
  openingBalance Decimal         @default(0) @db.Decimal(18, 2)
  currentBalance Decimal         @default(0) @db.Decimal(18, 2)
  companyId      String?         @unique
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  payments       Payment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, email])
  @@unique([userId, companyId])
  @@index([userId, name])
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  number             String              @db.VarChar(50)
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             PurchaseOrderStatus @default(DRAFT)
  type               PurchaseType        @default(CREDIT_PURCHASE)
  orderDate          DateTime            @default(now())
  expectedDate       DateTime?
  subtotal           Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(18, 2)
  total              Decimal             @default(0) @db.Decimal(18, 2)
  paidAmount         Decimal             @default(0) @db.Decimal(18, 2)
  notes              String?             @db.Text
  items              PurchaseOrderItem[]
  paymentAllocations PaymentAllocation[]
  stockMovements     StockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, number])
  @@index([userId, supplierId, status])
  @@index([userId, orderDate])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal       @db.Decimal(18, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(18, 3)
  unitPrice        Decimal       @db.Decimal(18, 2)
  taxRate          Decimal       @default(0) @db.Decimal(7, 4)
  lineTotal        Decimal       @db.Decimal(18, 2)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model Invoice {
  id                 String              @id @default(cuid())
  number             String              @db.VarChar(50)
  contactId          String
  contact            Contact             @relation(fields: [contactId], references: [id])
  userId             String
  user               User                @relation("InvoiceTenant", fields: [userId], references: [id], onDelete: Cascade)
  type               InvoiceType
  status             InvoiceStatus       @default(DRAFT)
  issueDate          DateTime            @default(now())
  dueDate            DateTime?
  subtotal           Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal             @default(0) @db.Decimal(18, 2)
  total              Decimal             @default(0) @db.Decimal(18, 2)
  paidAmount         Decimal             @default(0) @db.Decimal(18, 2)
  notes              String?             @db.Text
  stockOverride      Boolean             @default(false)
  affectsStock       Boolean             @default(true)
  createdById        String
  createdBy          User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  items              InvoiceItem[]
  paymentAllocations PaymentAllocation[]
  stockMovements     StockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, number])
  @@index([userId, contactId, status])
  @@index([userId, issueDate])
  @@index([userId, dueDate, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  description String? @db.VarChar(255)
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  unitCost    Decimal @db.Decimal(18, 2)
  taxRate     Decimal @default(0) @db.Decimal(7, 4)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id          String              @id @default(cuid())
  number      String              @db.VarChar(50)
  partyType   PaymentPartyType
  direction   PaymentDirection
  method      PaymentMethod
  amount      Decimal             @db.Decimal(18, 2)
  reference   String?             @db.VarChar(191)
  paymentDate DateTime            @default(now())
  contactId   String?
  contact     Contact?            @relation(fields: [contactId], references: [id])
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  userId      String
  user        User                @relation("PaymentTenant", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User                @relation("PaymentCreator", fields: [createdById], references: [id])
  allocations PaymentAllocation[]
  notes       String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, number])
  @@index([userId, contactId, paymentDate])
  @@index([userId, supplierId, paymentDate])
  @@index([userId, paymentDate, direction])
}

model PaymentAllocation {
  id              String         @id @default(cuid())
  paymentId       String
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal        @db.Decimal(18, 2)
  createdAt       DateTime       @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@index([purchaseOrderId])
}

model StockMovement {
  id              String            @id @default(cuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  warehouseId     String?
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  userId          String
  user            User              @relation("StockMovementTenant", fields: [userId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(18, 3)
  quantityBefore  Decimal           @db.Decimal(18, 3)
  quantityAfter   Decimal           @db.Decimal(18, 3)
  reference       String?           @db.VarChar(100)
  note            String?           @db.Text
  invoiceId       String?
  invoice         Invoice?          @relation(fields: [invoiceId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdById     String
  createdBy       User              @relation("StockMovementCreator", fields: [createdById], references: [id])
  occurredAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())

  @@index([userId, productId, occurredAt])
  @@index([userId, warehouseId, occurredAt])
  @@index([userId, invoiceId])
  @@index([userId, purchaseOrderId])
}

model Expense {
  id          String        @id @default(cuid())
  category    String        @db.VarChar(100)
  description String        @db.VarChar(255)
  amount      Decimal       @db.Decimal(18, 2)
  method      PaymentMethod
  expenseDate DateTime      @default(now())
  reference   String?       @db.VarChar(191)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, expenseDate, category])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      ActivityAction
  entityType  String         @db.VarChar(100)
  entityId    String?        @db.VarChar(191)
  description String?        @db.Text
  oldValues   Json?
  newValues   Json?
  ipAddress   String?        @db.VarChar(45)
  userAgent   String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model CompanySetting {
  id                 Int      @id @default(autoincrement())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String   @db.VarChar(191)
  email              String?  @db.VarChar(191)
  phone              String?  @db.VarChar(50)
  address            String?  @db.Text
  logoUrl            String?  @db.VarChar(500)
  currency           String   @default("PKR") @db.VarChar(3)
  timezone           String   @default("Asia/Karachi") @db.VarChar(100)
  taxNumber          String?  @db.VarChar(100)
  lowStockEmails     Boolean  @default(true)
  smtpHost           String?  @db.VarChar(191)
  smtpPort           Int?     @default(587)
  smtpUser           String?  @db.VarChar(191)
  smtpPassword       String?  @db.VarChar(500)
  smtpFrom           String?  @db.VarChar(191)
  emailNotifications Boolean  @default(true)
  watermarkText      String   @default("Am") @db.VarChar(50)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailReminders Boolean @default(true)
  taskReminders  Boolean @default(true)
  lowStockAlerts Boolean @default(true)
}
